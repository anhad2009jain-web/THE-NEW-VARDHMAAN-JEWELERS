---
import { getRateTable } from '../lib/pricing';
import { formatINR, formatDateTime } from '../lib/format';

const table = getRateTable();
const parts: string[] = [];
for (const purity of ['24K', '22K', '18K']) {
  const rate = table.rates[purity];
  parts.push(rate ? `${purity} ${formatINR(rate)}/g` : `${purity} —`);
}
---

<div class="rate-bar">
  <div class="container">
    <span><b>Today's Gold Rate</b></span>
    {parts.map((p) => <span>{p}</span>)}
    {table.updatedAt && <span>Updated: {formatDateTime(table.updatedAt)}</span>}
    {table.stale && <span class="stale">Rates need updating — prices shown as “Price on Request”</span>}
  </div>
</div>
