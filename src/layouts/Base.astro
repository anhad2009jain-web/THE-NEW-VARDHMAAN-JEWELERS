---
import '../styles/global.css';
import site from '../data/site.json';
import { asset } from '../lib/urls';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';


interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const pageTitle = title || site.businessName;
const metaDesc = description || site.footer.aboutBlurb || site.businessName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImg = ogImage ? new URL(asset(ogImage), Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={asset(site.favicon || '/favicon.svg')} />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDesc} />
    {ogImg && <meta property="og:image" content={ogImg} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    {site.demoMode && site.demoNotice && <div class="demo-notice">{site.demoNotice}</div>}
    
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
