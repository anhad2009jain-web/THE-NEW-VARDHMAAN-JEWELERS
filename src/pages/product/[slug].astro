---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import site from '../../data/site.json';
import { getProducts, resolveCategory } from '../../lib/content';
import { formatWeight } from '../../lib/format';
import { href, asset } from '../../lib/urls';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const d = product.data;
const { Content } = await product.render();
const category = await resolveCategory(d.category);

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

const waMessage = [
  `Hello ${site.businessName}, I would like to enquire about:`,
  '',
  `Product: ${d.name}`,
  `Product ID: ${d.productId}`,
  `Link: ${pageUrl}`,
].join('\n');

const waUrl = `https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent(waMessage)}`;
const telUrl = `tel:${site.contact.phonePrimary.replace(/\s/g, '')}`;

const related = (await getProducts())
  .filter((p) => p.slug !== product.slug && p.data.category === d.category)
  .slice(0, 4);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.name,
  sku: d.productId,
  image: d.photos.map((p) => new URL(asset(p), Astro.site).toString()),
  description: d.shortDescription || d.name,
  brand: { '@type': 'Brand', name: site.businessName },
};

const availLabel =
  d.availability === 'available'
    ? 'Available'
    : d.availability === 'sold'
      ? 'Sold'
      : 'Made to Order';
---

<Base title={d.name} description={d.shortDescription || `${d.name} — ${d.purity}, ${formatWeight(d.netGoldWeight)}`} ogImage={d.photos[0]}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="container">
    <div class="breadcrumbs">
      <a href={href('/collections')}>Collections</a>
      {category && <> / <a href={href(`/category/${category.slug}`)}>{category.data.name}</a></>} / {d.name}
    </div>

    <section class="section" style="padding-top:24px;">
      <div class="product-layout">
        <div>
          <div class="gallery-main">
            <img id="main-photo" src={asset(d.photos[0])} alt={d.name} width="1000" height="1000" fetchpriority="high" />
          </div>

          {d.photos.length > 1 && (
            <div class="gallery-thumbs">
              {d.photos.map((photo, i) => (
                <img
                  src={asset(photo)}
                  alt={`${d.name} — photo ${i + 1}`}
                  class={i === 0 ? 'active' : ''}
                  data-full={asset(photo)}
                  loading="lazy"
                  width="82"
                  height="82"
                />
              ))}
            </div>
          )}
        </div>

        <div>
          <div>
            {d.newArrival && <span class="badge">New Arrival</span>}
            {d.bestseller && <span class="badge">Bestseller</span>}
            <span class={`badge ${d.availability === 'sold' ? 'sold' : d.availability === 'made-to-order' ? 'order' : ''}`}>{availLabel}</span>
            {d.demo && <span class="badge demo">Demo</span>}
          </div>

          <h1 style="font-size:clamp(28px,4vw,42px); margin-top:10px;">{d.name}</h1>

          <p style="color:var(--taupe); font-size:13px; letter-spacing:.1em; text-transform:uppercase; margin-top:6px;">
            Product ID: {d.productId}
          </p>

          <table class="spec-table">
            <tbody>
              {category && <tr><th>Category</th><td><a href={href(`/category/${category.slug}`)} style="color:var(--gold-deep);">{category.data.name}</a></td></tr>}
              <tr><th>Metal</th><td style="text-transform:capitalize;">{d.metal}</td></tr>
              <tr><th>Purity</th><td>{d.purity}</td></tr>
              <tr><th>Gross Weight</th><td>{formatWeight(d.grossWeight)}</td></tr>
              <tr><th>Net Gold Weight</th><td>{formatWeight(d.netGoldWeight)}</td></tr>
              {d.stoneWeight > 0 && <tr><th>Stone Weight</th><td>{formatWeight(d.stoneWeight)}</td></tr>}
              <tr><th>Availability</th><td>{availLabel}</td></tr>
              {d.updatedAt && <tr><th>Last Updated</th><td>{d.updatedAt}</td></tr>}
            </tbody>
          </table>

          <div class="price-box" style="background:var(--ivory);">
            <h3 style="font-size:20px; margin-bottom:10px;">Hallmark &amp; Purity</h3>
            {d.bisHallmark && d.huid ? (
              <table class="spec-table" style="margin:0;">
                <tbody>
                  <tr><th>BIS Hallmark</th><td>Yes — BIS hallmarked</td></tr>
                  <tr><th>Purity Mark</th><td>{d.purity}</td></tr>
                  <tr><th>HUID</th><td style="letter-spacing:.08em;">{d.huid}</td></tr>
                  {d.hallmarkNote && <tr><th>Verification</th><td>{d.hallmarkNote}</td></tr>}
                </tbody>
              </table>
            ) : (
              <p style="font-size:14px; color:var(--taupe);">Hallmark details available at store.</p>
            )}
          </div>

          <div class="cta-row">
            <a class="btn btn-solid" href={waUrl} target="_blank" rel="noopener">Enquire on WhatsApp</a>
            <a class="btn btn-dark" href={telUrl}>Call Store</a>
            {site.googleMapsUrl && (
              <a class="btn btn-dark" href={site.googleMapsUrl} target="_blank" rel="noopener">Visit Showroom</a>
            )}
          </div>

          {d.shortDescription && <p style="color:var(--taupe); margin-top:14px;">{d.shortDescription}</p>}

          <div style="margin-top:10px; max-width:60ch;">
            <Content />
          </div>
        </div>
      </div>
    </section>

    {related.length > 0 && (
      <section class="section alt" style="padding-left:0; padding-right:0;">
        <div class="section-head">
          <h2>You May Also Like</h2>
          <div class="rule"></div>
        </div>
        <div class="grid">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    )}
  </div>

  <script>
    const main = document.getElementById('main-photo');
    document.querySelectorAll('.gallery-thumbs img').forEach((thumb) => {
      thumb.addEventListener('click', () => {
        if (main && thumb.dataset.full) main.src = thumb.dataset.full;
        document.querySelectorAll('.gallery-thumbs img').forEach((t) => t.classList.remove('active'));
        thumb.classList.add('active');
      });
    });
  </script>
</Base>
