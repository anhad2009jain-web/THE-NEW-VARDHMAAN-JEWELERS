---
import Base from '../../layouts/Base.astro';
import { getAlbums } from '../../lib/content';
import { href, asset } from '../../lib/urls';

export async function getStaticPaths() {
  const albums = await getAlbums();
  return albums.map((album) => ({ params: { slug: album.slug }, props: { album } }));
}

const { album } = Astro.props;
const a = album.data;
---

<Base title={a.name} description={a.description || `${a.name} — photo album`} ogImage={a.coverImage}>
  <div class="container">
    <div class="breadcrumbs"><a href={href('/gallery')}>Gallery</a> / {a.name}</div>
    <div class="page-head">
      <h1>{a.name}</h1>
      {a.description && <p>{a.description}</p>}
    </div>

    <section class="section" style="padding-top:32px;">
      <div class="grid cols-3 album-grid">
        {a.images.map((img) => (
          <figure class="card">
            <div class="thumb" style="aspect-ratio:4/3;">
              <img src={asset(img.src)} alt={img.caption || a.name} loading="lazy" width="800" height="600" />
            </div>
            {img.caption && (
              <figcaption class="card-body" style="padding:12px 16px;">
                <p style="font-size:13px; color:var(--taupe);">{img.caption}</p>
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    </section>
  </div>
</Base>
